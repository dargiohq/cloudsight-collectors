{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TemporaryDiscoveryAndBillingTest",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "cloudfront:ListDistributions",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "dynamodb:ListTables",
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "lambda:ListFunctions",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "s3:ListAllMyBuckets",
        "sns:ListTopics",
        "sqs:ListQueues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayInventory",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:*::/restapis"
    },
    {
      "Sid": "RemoveOnlyOurTestLogGroup",
      "Effect": "Allow",
      "Action": "logs:DeleteLogGroup",
      "Resource": "arn:aws:logs:us-east-1:837501718562:log-group:/aws/lambda/cloudsight-e2e-2026100310-CloudSightCollectorFunct-cD7vdOr6gRWa:*"
    }
  ]
}
